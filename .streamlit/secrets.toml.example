# Copy these values into the Streamlit Community Cloud app's Settings > Secrets page.
# Do not rename this file to secrets.toml and commit real credentials to GitHub.
[google_oauth]
client_id = "YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID"
client_secret = "YOUR_GOOGLE_OAUTH_WEB_CLIENT_SECRET"
redirect_uri = "https://cei-qoe-profiler.streamlit.app/"
